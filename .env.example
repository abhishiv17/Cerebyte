# =============================================
# Cerebyte — Environment Variables Template
# =============================================
# Copy this file to .env (for backend) and fill in your values.
# Note: The frontend uses a separate .env.local file.

# --- Backend (FastAPI) Variables ---
# Supabase (get from: supabase.com → project → Settings → API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# AI Tutor (Groq)
GROQ_API_KEY="your_groq_api_key_here"

# --- Frontend (Next.js) Variables ---
# (Usually placed in frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
NEXT_PUBLIC_API_URL="http://localhost:8000"
